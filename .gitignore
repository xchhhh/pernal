# ======================================================================
# Git 忽略清单：这些文件/目录不进版本库
# 原则：密钥、本地数据、缓存、构建产物都不该提交
# 注意：gitignore 不支持行内注释，# 必须独占一行，否则会被当成模式的一部分
# ======================================================================

# ---- Python 通用 ----
# 编译后的 .pyc
__pycache__/
*.py[cod]
# 本地虚拟环境（每个人的路径不同，不提交）
.venv/
venv/

# ---- 密钥与环境 ----
# 真实环境变量（含 API key），绝不进库！只提交 .env.example
.env
# SSH 私钥（部署脚本生成，仅本地留底，绝不进库！）
id_ed25519
scripts/id_ed25519
# 其他私钥格式
*.pem
*.key

# ---- 本地数据（Chroma 向量目录 + SQLite 库文件）----
# SQLite 业务库
app/data/*.db
# Chroma 持久化目录
app/data/chroma/
app/data/*.sqlite

# ---- 测试与构建 ----
# pytest 缓存
.pytest_cache/
dist/
build/
*.egg-info/

# ---- 编辑器/IDE ----
.idea/
.vscode/

# ---- 部署日志（本地运行产物，不入库）----
scripts/*.log
scripts/*.out
scripts/vps_deploy.out.log
# 本地临时调试脚本（_ 前缀）不入库
scripts/_*.py
