# ======================================================================
# 环境变量模板（把本文件复制成 .env 后填真实值）
# 规则：.env 不进 git（已被 .gitignore 忽略）；生产环境由宿主机的真实
#       环境变量注入，不依赖文件。所有密钥都走这里，绝不写死在代码里。
# ======================================================================

# ---- 应用基础信息 ----
APP_NAME=AI 应用开发门户
ENVIRONMENT=production          # development / production（影响调试开关）
HOST=0.0.0.0                    # 容器内监听地址
PORT=8000                       # 容器内端口，Caddy 会把 443 反代到这里
SITE_DOMAIN=                     # 暂无域名→留空（用公网 IP 访问）；拿到域名(或 duckdns.org 免费子域)后填这里，Caddy 自动 HTTPS

# ---- 数据与向量库 ----
DATABASE_URL=sqlite:///./app/data/portal.db   # SQLite 业务库（板块内容/留言/图谱三元组）
CHROMA_PERSIST_DIR=./app/data/chroma          # Chroma 向量库持久化目录（进程内，不引独立服务）

# ---- 安全 ----
SECRET_KEY=change-me-in-prod     # 会话签名等用途，生产必须换成随机长字符串

# ---- 限流（防刷）----
RATE_LIMIT_PER_MINUTE=60         # 单 IP 每分钟最多请求数

# ---- 云端 LLM（DeepSeek，OpenAI 兼容）----
LLM_API_KEY=                     # DeepSeek API Key（真实值已挪到 .env，勿在此填，避免提交 git 泄露）
LLM_BASE_URL=https://api.deepseek.com/v1   # DeepSeek 的 OpenAI 兼容接口地址
LLM_MODEL=deepseek-chat          # 用的模型名

# ---- 云端 Embedding（先用 DeepSeek，接口若不可用改硅基流动 BGE）----
EMBEDDING_API_KEY=           # 火山引擎 Ark（豆包）Embedding Key（真实值已挪到 .env）
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   # Embedding 接口地址
EMBEDDING_MODEL=doubao-embedding-vision-250615   # 火山引擎 Ark 的豆包 embedding（中文效果好；如需纯文本嵌入可换 doubao-embedding-text-240715）

# ---- 联系表单（可选 SMTP；不配则只存库不发送邮件）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# ---- 日志 ----
LOG_LEVEL=INFO
